{
  "manifest_version": 3,
  "name": "Meet Not Alma Botu",
  "version": "1.0.0",
  "minimum_chrome_version": "102",
  "description": "Meet altyazısından transkript alır. Planlı saatte sizin hesabınızla, mikrofon ve kamera kapalı katılır. Ses kaydetmez.",
  "permissions": ["storage", "downloads", "alarms"],
  "host_permissions": ["https://meet.google.com/*"],
  "background": {
    "service_worker": "src/background/service-worker.js"
  },
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "src/options/options.html",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://meet.google.com/*"],
      "js": [
        "src/content/transcript-engine.js",
        "src/content/meet-adapter.js",
        "src/content/meet-join.js",
        "src/content/content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
